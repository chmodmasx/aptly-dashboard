# Dashboard image.
# For local development with compose.dev.yaml use aptly-dashboard:local.
DASHBOARD_IMAGE=aptly-dashboard:local

# Required: choose an Aptly image that provides the API/runtime contract.
APTLY_IMAGE=

# Internal Aptly API URL as seen by the Dashboard backend.
APTLY_URL=http://aptly:8080
APTLY_PROFILE_NAME=Aptly del stack

# Data-root target expected by the selected Aptly image.
APTLY_DATA_PATH=/opt/aptly

# Existing shared network used by your reverse proxy.
# Example for Nginx Proxy Manager:
PROXY_NETWORK=nginx-proxy-manager_default

# Optional loopback access to the Dashboard on the Docker host.
DASHBOARD_HOST_BIND=127.0.0.1
DASHBOARD_HOST_PORT=8080

# Usually none inside the private stack network.
APTLY_AUTH_MODE=none
APTLY_AUTH_USERNAME=
APTLY_AUTH_PASSWORD=
APTLY_AUTH_TOKEN=
APTLY_AUTH_HEADER_NAME=
APTLY_AUTH_HEADER_VALUE=

# Public tree as seen from repo-server's read-only aptly-data mount.
APTLY_PUBLIC_ROOT=/aptly/public
